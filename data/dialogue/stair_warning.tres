lines = Array[Dictionary]([{"name": "Marshal", "text": "Site is closed. Come back never.", "portrait": "crew_grunt"}, {"name": "Kip", "text": "Closed by who?", "portrait": "kip"}, {"name": "Marshal", "text": "By the order. There is a date on it and everything.", "portrait": "crew_grunt"}, {"name": "Kip", "text": "What date?", "portrait": "kip"}, {"name": "Marshal", "text": "Thursday.", "portrait": "crew_grunt", "start_quest": "q_stand", "end": true}])
