[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/DialogueData.gd" id="1_foreman_meet"]

[resource]
script = ExtResource("1_foreman_meet")
id = "foreman_meet"
lines = Array[Dictionary]([{"name": "Foreman", "text": "You are standing in a work area.", "portrait": "site_foreman"}, {"name": "Kip", "text": "There are forty flats up there with no other way out.", "portrait": "kip"}, {"name": "Foreman", "text": "I know. It is in the impact section.", "portrait": "site_foreman"}, {"name": "Kip", "text": "You read it?", "portrait": "kip"}, {"name": "Foreman", "text": "I wrote it.", "portrait": "site_foreman"}, {"name": "Kip", "text": "Then stop.", "portrait": "kip"}, {"name": "Foreman", "text": "I cannot stop. I can be stopped. It is a distinction that matters enormously to my insurance.", "portrait": "site_foreman"}, {"name": "Kip", "text": "...that is an invitation.", "portrait": "kip"}, {"name": "Foreman", "text": "That is a man who would like to go home and cannot say so.", "portrait": "site_foreman", "end": true}])
pause_game = true
once_flag = ""
