[ext_resource type="Script" path="res://data/DialogueData.gd" id="1_pops_intro"]

[resource]
script = ExtResource("1_pops_intro")
id = "pops_intro"
lines = Array[Dictionary]([{"name": "Pops", "text": "You're the one making noise on my street.", "portrait": "pops"}, {"name": "Kip", "text": "The Grease Monkeys were making noise. I made it stop.", "portrait": "kip"}, {"name": "Pops", "text": "Same volume from where I sit.", "portrait": "pops"}, {"name": "Pops", "text": "Rust Rats took my yard last week. If you're going that way, take something with a handle.", "portrait": "pops", "set_flag": "met_pops", "start_quest": "q_yard", "shop": "pops_gear", "end": true}])
pause_game = true
once_flag = ""
