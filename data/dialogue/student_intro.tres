lines = Array[Dictionary]([{"name": "Student", "text": "They took my bag. My BAG. My whole semester is in that bag.", "portrait": "student"}, {"name": "Kip", "text": "Who did?", "portrait": "kip"}, {"name": "Student", "text": "Guys with wrenches. They went into the alley. They said the bag was 'evidence'. Evidence of WHAT? Chemistry?", "portrait": "student"}, {"name": "Kip", "text": "I'll get it.", "portrait": "kip", "start_quest": "q_backpack", "end": true}])
