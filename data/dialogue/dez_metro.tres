[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/DialogueData.gd" id="1_dez_metro"]

[resource]
script = ExtResource("1_dez_metro")
id = "dez_metro"
lines = Array[Dictionary]([{"name": "Dez", "text": "You look like someone who has been told a laundromat is a front.", "portrait": "dez"}, {"name": "Kip", "text": "Money comes in Tuesdays. From the metro side. Carried by someone who never gets off the train.", "portrait": "kip"}, {"name": "Dez", "text": "That is either nonsense or the most useful thing anyone has said all year.", "portrait": "dez"}, {"name": "Kip", "text": "The gate is chained.", "portrait": "kip"}, {"name": "Dez", "text": "That gate has been chained since we were nine. The chain is decorative.", "portrait": "dez", "set_flag": "metro_open", "start_quest": "q_tuesday", "end": true}])
pause_game = true
once_flag = ""
