[gd_resource type="Resource" script_class="DialogueData" load_steps=2 format=3]

[ext_resource type="Script" path="res://data/DialogueData.gd" id="1_manager_reveal"]

[resource]
script = ExtResource("1_manager_reveal")
id = "manager_reveal"
lines = Array[Dictionary]([{"name": "Kip", "text": "Who tells you to do it?", "portrait": "kip"}, {"name": "Manager", "text": "Nobody tells me. The form arrives. I sign the form.", "portrait": "line_manager"}, {"name": "Kip", "text": "What form?", "portrait": "kip"}, {"name": "Manager", "text": "Community liaison. Line 4. It has arrived every Tuesday for eleven years.", "portrait": "line_manager"}, {"name": "Kip", "text": "Line 4 is closed.", "portrait": "kip"}, {"name": "Manager", "text": "Line 4 is *suspended*. Nobody has ever closed it. A closed line is a decision and a decision needs a name on it.", "portrait": "line_manager"}, {"name": "Kip", "text": "So it still gets money.", "portrait": "kip"}, {"name": "Manager", "text": "It still gets a budget. A budget has to be spent or it is reduced, and a reduced budget is somebody noticing.", "portrait": "line_manager"}, {"name": "Kip", "text": "And the money goes to gangs.", "portrait": "kip"}, {"name": "Manager", "text": "The money goes to community liaison. Quiet streets. No complaints about a line that does not run. It has worked perfectly.", "portrait": "line_manager"}, {"name": "Kip", "text": "You paid people to hurt each other so nobody would ask a question.", "portrait": "kip"}, {"name": "Manager", "text": "I paid people to be quiet. What they did with quiet was their own business.", "portrait": "line_manager", "end": true}])
pause_game = true
once_flag = ""
